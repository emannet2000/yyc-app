{
  "name": "yyc-brokers-nodejs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "YYC Brokers Node.js pilot starter with persistent accounts and shipment workflows",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "client": "vite",
    "client:build": "vite build",
    "setup-admin": "node scripts/setup-admin.js",
    "backup": "node scripts/backup.js",
    "migrate": "node src/db/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@googlemaps/google-maps-services-js": "^3.4.0",
    "@sentry/node": "^7.120.4",
    "@sentry/profiling-node": "^11.12.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "compression": "^1.8.2",
    "firebase-admin": "^12.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "otpauth": "^9.6.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "pino": "^8.21.0",
    "pino-pretty": "^11.3.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^4.0.0",
    "socket.io": "^4.8.4",
    "stripe": "^17.3.1",
    "twilio": "^5.13.1"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "supertest": "^7.3.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
